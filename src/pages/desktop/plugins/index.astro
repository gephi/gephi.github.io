---
import { Image } from "astro:assets";
import { isNil, orderBy, reverse, sum, uniq } from "lodash-es";
import { Icon } from "astro-icon/components";
import Banner from "../../../components/Banner.astro";
import Default from "../../../images/plugins/default-screenshot.jpg";
import Layout from "../../../layouts/Layout.astro";
import { PluginsFilters } from "../../../components/plugins/PluginsFilters";
import type { Plugin } from "../../../type";
import { pluginElementId, pluginHasModernVersion } from "../../../components/plugins/utils";

const pluginsDataRequest = await fetch(
  "https://raw.githubusercontent.com/gephi/gephi-plugins/refs/heads/gh-pages/plugins/plugins.json",
);

// Downloads per plugin file over the last 90 days, counted by workers/plugin-downloads. The list stays
// ordered by last update if they can't be loaded.
const downloadsRequest = await fetch("https://gephi.org/gephi-plugins/plugins/downloads.json").catch(() => null);
const downloadsByFile: Record<string, number> = downloadsRequest?.ok ? (await downloadsRequest.json()).downloads : {};

// Plugins with at least this many downloads come first, most downloaded first. The others follow, most
// recently updated first.
const POPULAR_DOWNLOADS = 25;

function popularity(p: Plugin): number {
  // Gephi versions with the same minor version share a file
  const files = uniq(Object.values(p.versions).map((v) => v.url));
  const downloads = sum(files.map((file) => downloadsByFile[file] ?? 0));
  return downloads >= POPULAR_DOWNLOADS ? downloads : 0;
}

// Reversed first, so that among plugins updated the same day, the last added comes first
const pluginsData: Plugin[] | null = pluginsDataRequest.ok
  ? orderBy(
      reverse((await pluginsDataRequest.json()).plugins as Plugin[]),
      [popularity, (p) => new Date(p.last_update)],
      ["desc", "desc"],
    )
  : null;

// Matches PluginsFilters' default (legacy plugins hidden) so the count doesn't flash/mismatch
// before hydration, and stays correct for no-JS clients.
const defaultVisibleCount = pluginsData?.filter(pluginHasModernVersion).length ?? 0;
---

<Layout
  pageId="desktop-plugins"
  title="Gephi Plugins"
  description="Browse community-developed plugins for Gephi, the open graph viz platform, or learn how to create and share your own."
>
  <Banner>
    <div class="banner-contents">
      <div class="banner-texts">
        <div>
          <h1 class="gephi-font">Gephi plugins</h1>
        </div>

        <p class="fs-3">Extend Gephi with <strong>community-developed</strong> plugins, or create your own.</p>

        <div>
          <a href="https://docs.gephi.org/desktop/Plugins/" class="btn btn-white fs-4 fw-bold">
            <Icon name="ph:arrow-square-out-bold" /> Read the doc
          </a>
        </div>
      </div>
    </div>
  </Banner>

  <main class="plugins-main">
    {
      pluginsData === null ? (
        <h2>Sorry plugins data could not be loaded</h2>
      ) : (
        <>
          <PluginsFilters plugins={pluginsData} client:only />

          <section class="plugins-list-container container-fluid">
            <h2 id="plugins-list-total">
              {defaultVisibleCount || "No"} {defaultVisibleCount > 1 ? "plugins" : "plugin"}
            </h2>
            <div class="plugins-list row">
              {pluginsData.map((p) => (
                <article id={pluginElementId(p.id)} class={`category-${p.category}`}>
                  <a class="card" href={`/desktop/plugins/${p.id}`}>
                    {!isNil(p.images) && p.images[0] !== undefined ? (
                      <Image
                        inferSize
                        alt=""
                        class="card-img-top plugin-image"
                        layout="constrained"
                        src={`https://raw.githubusercontent.com/gephi/gephi-plugins/refs/heads/gh-pages/plugins/${p.images[0].image}`}
                      />
                    ) : (
                      <Image alt="" class="card-img-top plugin-image" layout="constrained" src={Default} />
                    )}
                    <div>
                      <small class="plugin-category">{p.category}</small>
                    </div>
                    <h3 class="plugin-name">{p.name}</h3>
                    <p class="plugin-description">{p.short_description}</p>
                    <div class="text-muted">last updated on {p.last_update}</div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        </>
      )
    }
  </main>
</Layout>
