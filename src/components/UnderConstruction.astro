---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Banner from "./Banner.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Layout>
  <Banner>
    <div class="d-flex gap-3 fs-1 w-100">
      <Icon class="underconstruction_icon" name="ph:barricade" />
      <Icon class="underconstruction_icon" name="ph:shovel" />
      <Icon class="underconstruction_icon" name="ph:toolbox" />
      <Icon class="underconstruction_icon" name="ph:screwdriver" />
      <Icon class="underconstruction_icon" name="ph:hammer" />
      <Icon class="underconstruction_icon" name="ph:crane-tower" />
      <Icon class="underconstruction_icon" name="ph:pencil-ruler" />
      <Icon class="underconstruction_icon" name="ph:pipe" />
    </div>
    <h1>
      {title} page not ready yet!
    </h1>
  </Banner>

  <main class="container py-5">
    <section class="fs-2">
      <slot />
      <p>We are working on it...</p>
    </section>
    <section>
      <slot name="more-information" />
    </section>
  </main>
</Layout>
